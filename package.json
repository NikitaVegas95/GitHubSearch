{
  "name": "github-repo-search",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "prepare": "husky",
    "hooks:check": "sh scripts/hooks/check-hooks.sh",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "lint:styles": "stylelint \"src/**/*.scss\" --max-warnings=0",
    "lint:styles:fix": "stylelint \"src/**/*.scss\" --fix",
    "lint:all": "npm run lint && npm run lint:styles",
    "lint:fix:all": "npm run lint:fix && npm run lint:styles:fix",
    "checks:full": "npm run hooks:check && npm run lint:fix:all && npm run lint:all && npm run build"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1",
    "react-redux": "^9.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@stylistic/eslint-plugin": "^2.12.1",
    "@types/react": "^18.3.8",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "eslint": "^9.17.0",
    "eslint-import-resolver-typescript": "^4.3.5",
    "eslint-plugin-boundaries": "^4.2.2",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "sass": "^1.89.0",
    "stylelint": "^16.12.0",
    "stylelint-config-recess-order": "^5.1.1",
    "stylelint-config-standard-scss": "^13.1.0",
    "typescript-eslint": "^8.18.2",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}
